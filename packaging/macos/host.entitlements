<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime entitlements for the host. Screen Recording (ScreenCaptureKit) and
     Accessibility (CGEvent input) are TCC grants the user gives in System Settings, not
     entitlements; the app only needs to be signed with a stable identity so the grants
     survive updates. Audio input covers capture through the audio device path. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>

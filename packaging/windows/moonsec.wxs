<?xml version="1.0" encoding="utf-8"?>
<!--
  moonsec MSI (WiX v4 schema; built with the WiX .NET tool by build.ps1).

  Installs to Program Files\moonsec:
    moonsec.exe       the host agent and client (today's `moonsec` tool)
    moonsec-svc.exe   the `moonsec` service: starts moonsec.exe in the console user's
                      session and moves it when the session changes (svc/main.zig)
    THIRD_PARTY_NOTICES.md
    driver\           the IddCx virtual display driver, when built with -d IddDir=...
                      (PR #39); added with pnputil, removed again on uninstall

  Preprocessor variables (wix build -d):
    Version   four-part numeric version (packaging/version.sh's MOONSEC_VERSION_NUM)
    BinDir    folder with moonsec.exe and moonsec-svc.exe
    Notices   THIRD_PARTY_NOTICES.md for this package
    IddDir    optional: the signed driver package (MoonsecIdd.inf, .dll, .cat)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(sys.BUILDARCH) = arm64 ?>
  <?define UtilCA = Wix4UtilCA_A64 ?>
  <?else?>
  <?define UtilCA = Wix4UtilCA_X64 ?>
  <?endif?>
  <Package Name="moonsec" Manufacturer="moonsec" Version="$(var.Version)"
           UpgradeCode="6f3d2c8e-6a51-4f0b-9b0e-3c8f6d1a7b24" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of moonsec is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/progrium/moonsec" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="moonsec">
        <?ifdef IddDir ?>
        <Directory Id="DRIVERFOLDER" Name="driver" />
        <?endif?>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Core" Directory="INSTALLFOLDER">
      <Component Id="MoonsecExe">
        <File Id="moonsec.exe" Source="$(var.BinDir)\moonsec.exe" KeyPath="yes" />
      </Component>
      <Component Id="Service">
        <File Id="moonsec_svc.exe" Source="$(var.BinDir)\moonsec-svc.exe" KeyPath="yes" />
        <ServiceInstall Id="MoonsecService" Name="moonsec" DisplayName="moonsec host"
                        Description="Starts the moonsec host in the signed-in user's session so the desktop can be streamed."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes" />
        <ServiceControl Id="MoonsecServiceControl" Name="moonsec" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="Notices">
        <File Id="THIRD_PARTY_NOTICES.md" Source="$(var.Notices)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <?ifdef IddDir ?>
    <ComponentGroup Id="Idd" Directory="DRIVERFOLDER">
      <Component Id="IddFiles">
        <File Id="MoonsecIdd.inf" Source="$(var.IddDir)\MoonsecIdd.inf" KeyPath="yes" />
        <File Id="MoonsecIdd.dll" Source="$(var.IddDir)\MoonsecIdd.dll" />
        <File Id="MoonsecIdd.cat" Source="$(var.IddDir)\MoonsecIdd.cat" />
        <File Id="driver.ps1" Source="$(sys.SOURCEFILEDIR)driver.ps1" />
      </Component>
    </ComponentGroup>
    <!-- pnputil adds the package to the driver store; the host creates the device while it
         streams. Deferred and not impersonated: they run as LocalSystem. -->
    <SetProperty Id="AddIddDriver" Before="AddIddDriver" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[DRIVERFOLDER]driver.ps1&quot; -Add" />
    <CustomAction Id="AddIddDriver" DllEntry="WixQuietExec64" BinaryRef="$(var.UtilCA)" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="RemoveIddDriver" Before="RemoveIddDriver" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[DRIVERFOLDER]driver.ps1&quot; -Remove" />
    <CustomAction Id="RemoveIddDriver" DllEntry="WixQuietExec64" BinaryRef="$(var.UtilCA)" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="AddIddDriver" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveIddDriver" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <?endif?>

    <Feature Id="Main" Title="moonsec" Level="1">
      <ComponentGroupRef Id="Core" />
      <?ifdef IddDir ?>
      <ComponentGroupRef Id="Idd" />
      <?endif?>
    </Feature>
  </Package>
</Wix>

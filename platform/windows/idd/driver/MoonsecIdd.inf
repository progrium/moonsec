;
; moonsec virtual display driver (IddCx, UMDF 2). See ../README.md.
;
; Matches two hardware IDs: "MoonsecIdd" for the software device the moonsec host
; creates while it runs (SwDeviceCreate), and "Root\MoonsecIdd" for a root device made
; once with devcon (for hosts that run without the rights to create software devices).
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=MoonsecIdd.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...17134

[Standard.NT$ARCH$.10.0...17134]
%DeviceName%=MoonsecIdd_Install, MoonsecIdd
%DeviceName%=MoonsecIdd_Install, Root\MoonsecIdd

[SourceDisksFiles]
MoonsecIdd.dll=1

[SourceDisksNames]
1=%DiskName%

[DestinationDirs]
UMDriverCopy=13

[UMDriverCopy]
MoonsecIdd.dll

[MoonsecIdd_Install.NT]
CopyFiles=UMDriverCopy

[MoonsecIdd_Install.NT.hw]
AddReg=MoonsecIdd_HardwareDeviceSettings

[MoonsecIdd_HardwareDeviceSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"MoonsecIddGroup"

[MoonsecIdd_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[MoonsecIdd_Install.NT.Wdf]
UmdfService=MoonsecIdd,MoonsecIdd_Install
UmdfServiceOrder=MoonsecIdd
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[MoonsecIdd_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\MoonsecIdd.dll
UmdfExtensions=IddCx0102

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

[Strings]
ManufacturerName="moonsec"
DiskName="moonsec virtual display driver"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="moonsec virtual display"

REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000

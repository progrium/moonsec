# systemd unit for iroh-relay on a Linux host (relay/README.md):
#   install -m 0755 iroh-relay /usr/local/bin/
#   install -m 0644 relay/iroh-relay.sysusers /usr/lib/sysusers.d/iroh-relay.conf && systemd-sysusers
#   install -D -m 0644 relay/iroh-relay.toml /etc/iroh-relay/iroh-relay.toml   # then edit it
#   install -m 0644 relay/iroh-relay.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now iroh-relay
[Unit]
Description=iroh relay for moonsec
Documentation=https://github.com/progrium/moonsec/blob/main/relay/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=iroh-relay
Group=iroh-relay
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/iroh-relay.toml
# Manual certs (default.crt, default.key) and the Let's Encrypt cache.
StateDirectory=iroh-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/iroh-relay
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576

# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: the relay needs its config, its state directory and the network, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target

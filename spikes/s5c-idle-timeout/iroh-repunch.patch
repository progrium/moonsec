+    /// moonsec S5c patch: one re-punch round, then schedule the next one with backoff.
+    fn repunch_step(&mut self) {
+        let Some(rp) = self.state.repunch.as_mut() else {
+            return;
+        };
+        let any_ip = self
+            .connections
+            .values()
+            .any(|c| c.paths.values().any(|p| p.is_ip()));
+        if any_ip || rp.started.elapsed() > REPUNCH_WINDOW {
+            debug!(any_ip, "moonsec repunch: done");
+            self.state.repunch = None;
+            self.trigger_holepunching();
+            return;
+        }
+        let delay = rp.next_retry;
+        rp.next_retry = (rp.next_retry * 2).min(REPUNCH_MAX_RETRY);
+        // Forget the last attempt so trigger_holepunching does not rate-limit this round.
+        self.state.last_holepunch = None;
+        self.trigger_holepunching();
+        let next = Instant::now() + delay;
+        // do_holepunching may already have scheduled a sooner retry (e.g. no CIDs yet).
+        self.state.scheduled_holepunch = Some(match self.state.scheduled_holepunch {
+            Some(t) if t < next => t,
+            _ => next,
+        });
+        debug!(?delay, "moonsec repunch: round started, next retry scheduled");
+    }

+// moonsec S5c patch: re-punch as soon as the last direct path is abandoned.
+//
+// Stock iroh only re-runs NAT traversal on candidate changes, on the 60 s upgrade check
+// or on a major network change, and rate-limits rounds to one per
+// HOLEPUNCH_ATTEMPTS_INTERVAL when candidates did not change. After an idle-timeout
+// close caused by a short outage, nothing changed, so the next round can be up to 60 s
+// away. With this patch, losing the last IP path starts a round immediately and retries
+// with exponential backoff, ignoring the 5 s rate limit, until an IP path is
+// established again or REPUNCH_WINDOW has passed.
+
+/// Delay before the first retry after the immediate round.
+const REPUNCH_FIRST_RETRY: Duration = Duration::from_millis(250);
+/// Upper bound on the delay between retries.
+const REPUNCH_MAX_RETRY: Duration = Duration::from_secs(2);
+/// How long after the close to keep retrying before falling back to stock behaviour.
+const REPUNCH_WINDOW: Duration = Duration::from_secs(15);
+
+/// State of a re-punch after the last direct path was abandoned.
+#[derive(Debug)]
+struct Repunch {
+    started: Instant,
+    next_retry: Duration,
+}
